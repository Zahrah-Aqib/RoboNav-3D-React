# Local developer setup (copy as .env.local next to package.json):
# VITE_API_URL=http://127.0.0.1:8000
#
# On Vercel FRONTEND project's Environment Variables:
# Key: VITE_API_URL
# Value: https://YOUR-NEW-3D-BACKEND.vercel.app
#
# Do not reuse the older React website's backend URL for the new project.
VITE_API_URL=http://127.0.0.1:8000
